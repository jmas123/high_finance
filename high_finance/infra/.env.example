# High Finance - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:YOUR_PASSWORD_HERE@db:5432/high_finance
POSTGRES_USER=user
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_DB=high_finance

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_NEW_SECRET_KEY_HERE

# Set to False in production
DEBUG=False

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# SEC EDGAR API (optional)
SEC_API_KEY=your_sec_api_key_here

# Groq AI API
GROQ_API_KEY=your_groq_api_key_here

# Quiver Quantitative API
QUIVER_API_KEY=your_quiver_api_key_here

# Federal Reserve Economic Data (FRED) API
FRED_API_KEY=your_fred_api_key_here

# =============================================================================
# S3 / OBJECT STORAGE (optional)
# =============================================================================
S3_BUCKET_NAME=your_s3_bucket_name
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_ENDPOINT_URL=  # Leave empty for AWS, set for MinIO/R2
