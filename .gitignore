# High Finance - Root .gitignore

# Environment files (CRITICAL - never commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
/docs
# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Node
node_modules/
**/node_modules/

# Logs
*.log
logs/

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Build artifacts
*.so
*.dylib
